# Copy to .env (local) or /home/lazyjapy/api/.env (server). Never commit real values.

# development | production
NODE_ENV=production
# Passenger sets PORT automatically on the server. Only used locally.
# PORT=3000

# MySQL (cPanel → MySQL Databases). Locally, leave DB_HOST empty to use the in-memory dev store.
DB_HOST=localhost
DB_USER=lazyjapy_api
DB_PASSWORD=change-me
DB_NAME=lazyjapy_site

# SMTP (cPanel mailbox no-reply@lazyninja.co)
SMTP_HOST=premium149.web-hosting.com
SMTP_PORT=465
SMTP_USER=no-reply@lazyninja.co
SMTP_PASS=change-me
MAIL_TO=tyler@lazyninja.co
# Optional; defaults to SMTP_USER
# MAIL_FROM=no-reply@lazyninja.co

# GitHub sources: org = LazyNinja brand, user = Tyler's personal account
GITHUB_SOURCES=org:LazyNinja-LLC,user:WammumTy
# Optional fine-grained read-only token (raises the rate limit). Public repos only.
GITHUB_TOKEN=
# Optional: regex for repo names to never show (coursework guard). Keep in sync with site/src/config/site.ts.
# Optional: minutes before a request may refresh the GitHub cache itself (default 60).
# The cron job (deploy/cron.md, every 15 min) normally keeps it fresher than this.
# GITHUB_CACHE_MINUTES=60
# GITHUB_EXCLUDE_PATTERN=^(cse|stt|mth|psy|cmse|ece)[-_ ]?\d{3}

# Site editor (/stats → Edit site): a fine-grained token that can write ONLY to the site repo.
# Resource owner LazyNinja-LLC, repo lazyninja.co, permissions Contents: read/write + Actions: read/write.
# Leave empty to disable editing. See DEPLOY.md → "Site editor".
GITHUB_WRITE_TOKEN=
# GITHUB_REPO=LazyNinja-LLC/lazyninja.co
# GITHUB_BRANCH=main

# Long random strings (e.g. `openssl rand -hex 32`)
ADMIN_TOKEN=change-me-long-random-string
ANALYTICS_SALT_SECRET=change-me-another-long-random-string

# Comma-separated origins allowed by CORS (localhost is added automatically outside production)
ALLOWED_ORIGINS=https://lazyninja.co,https://www.lazyninja.co

# Optional, dev only: force the in-memory store (never allowed in production)
# STORE=memory
