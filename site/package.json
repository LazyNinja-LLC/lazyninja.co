{
  "name": "lazyninja-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "github": "tsx scripts/fetch-github.ts",
    "github:ensure": "tsx scripts/fetch-github.ts --ensure",
    "predev": "npm run github:ensure",
    "dev": "astro dev",
    "prebuild": "npm run github",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "pretypecheck": "npm run github:ensure",
    "typecheck": "astro check",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/east-sea-dokdo": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
