# Optional. Copy to site/.env for local builds.

# Raises the GitHub API rate limit for the build-time project sync (read-only, public repos).
GITHUB_TOKEN=

# Where the browser talks to the API. Defaults: http://localhost:3000 in dev, https://api.lazyninja.co in builds.
# PUBLIC_API_URL=http://localhost:3000

# Fail the build instead of keeping old data when GitHub is unreachable (deploys set this).
# GITHUB_FETCH_STRICT=1

# Include draft posts/write-ups in a local production build (never in deploys).
# SHOW_DRAFTS=1
