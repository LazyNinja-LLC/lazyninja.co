---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import type { Props as HeadProps } from '../components/BaseHead.astro';

export type Props = HeadProps & {
  /** Skip the page-view beacon (e.g. the private /stats page). */
  noTrack?: boolean;
};

const { noTrack = false, ...head } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light" data-api={SITE.apiUrl}>
  <head>
    <BaseHead {...head} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-accent px-4 py-2 font-semibold text-accent-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Fade-up (.reveal) and unrolling scrolls (.unroll) as they come into view.
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.15 },
      );
      document.querySelectorAll('.reveal, .unroll').forEach((el) => io.observe(el));
    </script>
    {!noTrack && <script>
      import { trackPageView } from '../lib/analytics';
      trackPageView();
    </script>}
  </body>
</html>
