---
/**
 * "The person behind the mask": Tyler's portrait with a black belt (태권도 in gold, two dan stripes)
 * tied across the top-left corner, and the Lego selfie as a polaroid.
 * Copy comes from settings/home.json (Edit site → Home); an empty `text` falls back to the second
 * paragraph of the About bio.
 */
import { Image } from 'astro:assets';
import { home } from '../../data/home';
import { bio } from '../../data/about';
import tyler from '../../assets/about/tyler.png';
import lego from '../../assets/about/lego-selfie.webp';

const { about } = home;
const intro = about.text || bio[1] || '';
const isPlaceholder = /placeholder/i.test(intro);
---

<section id="about" class="home-section" aria-labelledby="about-title">
  <div class="container-page sensei">
    <div class="portraits reveal">
      <div class="main">
        <Image
          src={tyler}
          alt="Illustrated profile of Tyler in a cream cap and black headphones, looking up."
          widths={[400, 700, 1000]}
          sizes="(max-width: 960px) 90vw, 520px"
        />
      </div>
      <svg class="belt-corner" viewBox="0 0 240 240" aria-hidden="true">
        <line x1="6" y1="214" x2="214" y2="6" stroke="#15120f" stroke-width="30"></line>
        <line
          x1="14"
          y1="216"
          x2="216"
          y2="14"
          stroke="rgba(255,255,255,.12)"
          stroke-width="1"
          stroke-dasharray="5 4"
        ></line>
        <line
          x1="4"
          y1="206"
          x2="206"
          y2="4"
          stroke="rgba(255,255,255,.12)"
          stroke-width="1"
          stroke-dasharray="5 4"
        ></line>
        <line x1="149" y1="44" x2="171" y2="66" stroke="#e8b65a" stroke-width="6"></line>
        <line x1="160" y1="33" x2="182" y2="55" stroke="#e8b65a" stroke-width="6"></line>
        <text
          x="58"
          y="156"
          transform="rotate(-45 58 156)"
          text-anchor="middle"
          dominant-baseline="central"
          font-size="29"
          fill="#e8b65a"
          letter-spacing="1"
          style="font-family: var(--font-brush)"
        >
          태권도
        </text>
        <path d="M94 116 L112 124 L90 222 L70 214 Z" fill="#0d0b09"></path>
        <path d="M110 124 L126 116 L146 214 L126 222 Z" fill="#15120f"></path>
        <rect
          x="90"
          y="92"
          width="34"
          height="30"
          rx="7"
          transform="rotate(-45 107 107)"
          fill="#0d0b09"
        ></rect>
        <rect
          x="96"
          y="98"
          width="22"
          height="18"
          rx="4"
          transform="rotate(-45 107 107)"
          fill="none"
          stroke="rgba(255,255,255,.1)"
        ></rect>
      </svg>
      <figure class="polaroid">
        <Image
          src={lego}
          alt="Tyler as a Lego minifigure in a purple hoodie taking a selfie on a beach full of sea lions."
          widths={[300, 500]}
          sizes="260px"
        />
        <figcaption>{about.photoCaption}</figcaption>
      </figure>
    </div>
    <div>
      <p class="kicker reveal">{about.kicker}</p>
      <h2 id="about-title" class="headline reveal d1" style="margin-bottom: 28px">
        {about.greeting} <em>{about.name}</em>
      </h2>
      {about.lead && <p class="big-line reveal d2">{about.lead}</p>}
      {intro && (
        <p class="small-line reveal d2">{isPlaceholder ? <span class="todo">{intro}</span> : intro}</p>
      )}
      <div class="actions reveal d3">
        <a class="pill" href="/about">
          About me
        </a>
        <a class="text-link" href="/resume.pdf">
          Download résumé
        </a>
      </div>
    </div>
  </div>
</section>
