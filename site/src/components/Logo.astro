---
export interface Props {
  class?: string;
  size?: number;
}
const { class: className = '', size = 36 } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <rect width="64" height="64" rx="16" fill="#0c0e12"></rect>
  <path d="M8 15h40l6-6 2 9-2 6-6-4H8z" fill="#ff5a36"></path>
  <rect x="9" y="27" width="46" height="15" rx="7.5" fill="#ecebe6"></rect>
  <g fill="#0c0e12" class="origin-[32px_34px] motion-safe:animate-blink">
    <rect x="16.5" y="32.5" width="13" height="2.6" rx="1.3"></rect>
    <path d="M19 34.4a4 4 0 0 0 8 0z"></path>
    <rect x="34.5" y="32.5" width="13" height="2.6" rx="1.3"></rect>
    <path d="M37 34.4a4 4 0 0 0 8 0z"></path>
  </g>
  <rect
    x="0.5"
    y="0.5"
    width="63"
    height="63"
    rx="15.5"
    fill="none"
    stroke="currentColor"
    stroke-opacity="0.15"
  ></rect>
</svg>
