---
import { NAV, SITE } from '../config/site';
import { cleanPath } from '../lib/seo';
import ThemeToggle from './ThemeToggle.astro';

const path = cleanPath(Astro.url.pathname);
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const left = NAV.slice(0, 3);
const right = NAV.slice(3);
---

<header class="site-header">
  <nav aria-label="Main" class="container-page bar">
    <ul class="links wide left">
      {left.map(({ href, label }) => (
        <li>
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <span class="chop" aria-hidden="true" lang="ko">
        닌
      </span>
      <span>LazyNinja</span>
    </a>
    <div class="end">
      <ul class="links wide">
        {right.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
    <ul class="links narrow">
      {NAV.map(({ href, label }) => (
        <li>
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    border-bottom: 1px solid var(--border);
    transition: background-color 0.5s;
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 64px;
  }
  .links {
    display: flex;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: block;
    padding: 6px 0;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--fg-2);
    border-bottom: 1.5px solid transparent;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--accent);
  }
  .links a[aria-current='page'] {
    border-bottom-color: var(--accent);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 25px;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .chop {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    padding-top: 2px;
    border-radius: 4px;
    background: var(--accent);
    color: #fff8ee;
    font-family: var(--font-brush);
    font-size: 24px;
    line-height: 1;
    transition:
      background-color 0.5s,
      transform 0.3s;
  }
  .brand:hover .chop {
    transform: rotate(-6deg);
  }
  .end {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 26px;
  }
  .narrow {
    display: none;
  }
  @media (max-width: 860px) {
    .bar {
      grid-template-columns: 1fr auto;
      row-gap: 0;
    }
    .wide {
      display: none;
    }
    .brand {
      grid-row: 1;
      grid-column: 1;
    }
    .end {
      grid-row: 1;
      grid-column: 2;
    }
    .narrow {
      display: flex;
      grid-column: 1 / -1;
      gap: 22px;
      overflow-x: auto;
      scrollbar-width: none;
      margin: 0 -22px;
      padding: 0 22px 8px;
    }
    .narrow::-webkit-scrollbar {
      display: none;
    }
    .narrow a {
      white-space: nowrap;
    }
  }
</style>
