---
import { NAV, SITE, SOCIALS } from '../config/site';

const year = new Date().getFullYear();
const links = [
  SOCIALS.githubOrg,
  SOCIALS.githubPersonal,
  SOCIALS.linkedin,
  { label: SITE.person.email, href: SOCIALS.email.href },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer class="site-footer">
  <!-- Brushed ink edge; hidden on pages that already end in the night contact band. -->
  <svg class="ink-edge" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 70 L0 52 C 80 40, 140 58, 220 44 S 380 20, 470 38 S 640 60, 730 34 S 900 10, 1000 36 S 1180 58, 1260 40 S 1400 26, 1440 30 L1440 70Z"></path>
  </svg>
  <div class="body">
    <div class="container-page cols">
      <div class="about">
        <a href="/" class="brand" aria-label={`${SITE.name} home`}>
          <span class="chop" aria-hidden="true" lang="ko">
            닌
          </span>
          <span>LazyNinja</span>
        </a>
        <p>{SITE.tagline}</p>
      </div>
      <nav aria-label="Footer">
        <h2>Site</h2>
        <ul class="two">
          {NAV.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
          <li>
            <a href="/contact">Contact</a>
          </li>
        </ul>
      </nav>
      <div>
        <h2>Elsewhere</h2>
        <ul>
          {links.map(({ label, href }) => (
            <li>
              <a href={href} {...(href.startsWith('http') ? { rel: 'me noopener' } : {})}>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="container-page legal">
      <p>
        © {year} {SITE.company}. All rights reserved.
      </p>
      <p class="swap">
        <span class="day">Made in daylight</span>
        <span class="night">Made after hours</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    color: #a39a8c;
  }
  /* The home page ends in its own night band, so the footer just continues it. */
  :global(main:has(> .cta-band:last-child)) + .site-footer {
    margin-top: 0;
  }
  :global(main:has(> .cta-band:last-child)) + .site-footer .ink-edge {
    display: none;
  }
  .ink-edge {
    display: block;
    width: 100%;
    height: 70px;
    margin-bottom: -1px;
    fill: var(--night);
  }
  :global([data-theme='dark']) .ink-edge {
    display: none;
  }
  .body {
    background: var(--night);
    border-top: 1px solid rgb(255 240 220 / 0.08);
  }
  .cols {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 44px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    color: #f5f2ea;
  }
  .chop {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    padding-top: 2px;
    border-radius: 4px;
    background: #b83a2b;
    color: #fff8ee;
    font-family: var(--font-brush);
    font-size: 22px;
    line-height: 1;
  }
  .about p {
    margin: 12px 0 0;
    max-width: 22rem;
    font-size: 14px;
  }
  h2 {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: #e8b65a;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 14px;
  }
  ul.two {
    grid-template-columns: 1fr 1fr;
    column-gap: 16px;
  }
  a:hover {
    color: #f5f2ea;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding-top: 20px;
    padding-bottom: 32px;
    border-top: 1px solid rgb(255 240 220 / 0.08);
    font-size: 12px;
  }
  .legal p {
    margin: 0;
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
