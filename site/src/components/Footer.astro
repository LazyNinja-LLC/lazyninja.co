---
import { NAV, SITE, SOCIALS } from '../config/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const links = [
  SOCIALS.githubOrg,
  SOCIALS.githubPersonal,
  SOCIALS.linkedin,
  { label: SITE.person.email, href: SOCIALS.email.href },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer class="mt-24 border-t border-border">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="space-y-3">
      <a href="/" class="inline-flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
        <Logo size={30} />
        <span class="font-display text-lg font-bold">
          Lazy<span class="text-accent">Ninja</span>
        </span>
      </a>
      <p class="max-w-xs text-sm text-muted">{SITE.tagline}</p>
    </div>
    <nav aria-label="Footer">
      <h2 class="eyebrow mb-3">Site</h2>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
        {NAV.map(({ href, label }) => (
          <li>
            <a href={href} class="text-muted hover:text-accent">
              {label}
            </a>
          </li>
        ))}
        <li>
          <a href="/contact" class="text-muted hover:text-accent">
            Contact
          </a>
        </li>
      </ul>
    </nav>
    <div>
      <h2 class="eyebrow mb-3">Elsewhere</h2>
      <ul class="space-y-2 text-sm">
        {links.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="text-muted hover:text-accent"
              {...(href.startsWith('http') ? { rel: 'me noopener' } : {})}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-border">
    <div class="container-page flex flex-wrap items-center justify-between gap-2 py-5 text-xs text-muted">
      <p>
        © {year} {SITE.company}. All rights reserved.
      </p>
      <p class="font-mono">Built lazily, shipped carefully.</p>
    </div>
  </div>
</footer>
