---
export interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  href?: string;
  linkLabel?: string;
}
const { eyebrow, title, id, href, linkLabel = 'View all' } = Astro.props;
---

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div class="space-y-2">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id} class="text-3xl font-bold sm:text-4xl">
      {title}
    </h2>
  </div>
  {href && (
    <a href={href} class="group inline-flex items-center gap-1 text-sm font-semibold text-accent">
      {linkLabel}
      <span aria-hidden="true" class="transition-transform motion-safe:group-hover:translate-x-1">
        →
      </span>
    </a>
  )}
</div>
