---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactCta from '../components/ContactCta.astro';
import { SITE } from '../config/site';
import { faq, services, steps } from '../data/hire';
import { ogImagePath, organizationJsonLd } from '../lib/seo';

const icons: Record<string, string> = {
  web: 'M3 5h18v14H3zM3 9h18M7 7h.01M10 7h.01',
  ai: 'M12 3l1.8 4.6L18 9l-4.2 1.4L12 15l-1.8-4.6L6 9l4.2-1.4zM18 15l.9 2.1L21 18l-2.1.9L18 21l-.9-2.1L15 18l2.1-.9z',
  tools: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z',
};

// Organization JSON-LD (with the services it offers) on Hire, in addition to the site-wide one.
const orgWithServices = {
  ...organizationJsonLd(),
  makesOffer: services.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: s.title, description: s.summary },
  })),
};
---

<BaseLayout
  title="Hire LazyNinja"
  description="LazyNinja LLC builds websites, AI integrations and small tools. Here is how working together goes."
  image={ogImagePath('hire')}
  jsonLd={[orgWithServices]}
>
  <PageHeader
    eyebrow={`Hire ${SITE.company}`}
    title="Let the ninja do the busywork"
    lead="LazyNinja LLC takes on web development, AI integrations and small tools. Clear scope, small steps, no lock-in."
  >
    <div class="mt-8">
      <a href="/contact?reason=hire" class="btn-primary">
        Start a project <span aria-hidden="true">→</span>
      </a>
    </div>
  </PageHeader>

  <section class="container-page py-14" aria-labelledby="services-title">
    <h2 id="services-title" class="mb-8 text-3xl font-bold">
      Services
    </h2>
    <ul class="grid gap-5 md:grid-cols-3">
      {services.map((s) => (
        <li class="card flex flex-col gap-4 p-7">
          <span class="grid size-12 place-items-center rounded-2xl bg-accent-soft text-accent">
            <svg
              viewBox="0 0 24 24"
              class="size-6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linejoin="round"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d={icons[s.icon]} />
            </svg>
          </span>
          <h3 class="font-display text-2xl font-bold">{s.title}</h3>
          <p class="text-muted">{s.summary}</p>
          <ul class="space-y-2 text-sm">
            {s.bullets.map((b) => (
              <li class="flex gap-2">
                <span class="text-accent" aria-hidden="true">
                  ✦
                </span>
                {b}
              </li>
            ))}
          </ul>
          {s.price && (
            <p class="mt-auto border-t border-border pt-4 font-display text-lg font-bold">{s.price}</p>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="container-page py-14" aria-labelledby="process-title">
    <h2 id="process-title" class="mb-8 text-3xl font-bold">
      How working together goes
    </h2>
    <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="card relative overflow-hidden p-6">
          <span
            class="absolute -top-4 -right-1 font-display text-8xl font-extrabold text-accent/10"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <p class="font-mono text-xs text-accent">Step {i + 1}</p>
          <h3 class="mt-2 font-display text-xl font-bold">{step.title}</h3>
          <p class="mt-2 text-sm text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-page max-w-3xl py-14" aria-labelledby="faq-title">
    <h2 id="faq-title" class="mb-8 text-3xl font-bold">
      FAQ
    </h2>
    <div class="divide-y divide-border rounded-[var(--radius-card)] border border-border">
      {faq.map(({ q, a }) => (
        <details class="group p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
            {q}
            <span class="text-accent transition-transform group-open:rotate-45" aria-hidden="true">
              +
            </span>
          </summary>
          <p class="mt-3 text-muted">{a}</p>
        </details>
      ))}
    </div>
  </section>

  <ContactCta
    title="Ready when you are"
    text="Tell LazyNinja about the project. A short note is plenty to start."
  />
</BaseLayout>
