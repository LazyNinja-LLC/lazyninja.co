---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { findProject, sourceForRepo } from '../../lib/projects';
import { formatDate, getWriteups } from '../../lib/content';
import { formatUpdated } from '../../components/projects/ProjectCard';
import { ogImagePath } from '../../lib/seo';

export async function getStaticPaths() {
  const writeups = await getWriteups();
  return writeups.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const project = findProject(entry.data.repo);
// The source is derived from the repo owner: LazyNinja-LLC → LazyNinja, WammumTy → Personal.
const source = sourceForRepo(entry.data.repo);
const repoUrl = project?.url ?? `https://github.com/${entry.data.repo}`;
const demo = entry.data.demo ?? project?.homepage ?? null;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={ogImagePath(`projects/${entry.id}`)}
  type="article"
>
  <article class="container-page max-w-4xl py-14">
    <a href="/projects" class="link text-sm">
      ← All projects
    </a>
    <header class="mt-6 space-y-5">
      <div class="flex flex-wrap gap-2">
        {source && (
          <span class={source.id === 'lazyninja' ? 'badge-lazyninja' : 'badge-personal'}>{source.label}</span>
        )}
        {project && (
          <span class={project.status === 'shipped' ? 'badge-shipped' : 'badge-building'}>
            {project.status === 'shipped' ? 'Shipped' : 'Building'}
          </span>
        )}
        {entry.data.draft && <span class="badge-building">Draft</span>}
      </div>
      <h1 class="text-4xl font-extrabold sm:text-5xl">{entry.data.title}</h1>
      <p class="text-lg text-muted">{entry.data.description}</p>

      <dl
        class="card grid grid-cols-2 gap-4 p-5 text-sm sm:grid-cols-4"
        data-repo-stats={entry.data.repo.toLowerCase()}
      >
        <div class="min-w-0">
          <dt class="text-xs text-muted">Repository</dt>
          <dd class="mt-1 truncate font-mono">
            <a class="link" href={repoUrl} rel="noopener">
              {entry.data.repo}
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-xs text-muted">Stars</dt>
          <dd class="mt-1 font-mono" data-stat="stars">
            {project?.stars ?? '–'}
          </dd>
        </div>
        <div>
          <dt class="text-xs text-muted">Last updated</dt>
          <dd class="mt-1 font-mono">
            <time data-stat="updated" datetime={project?.updatedAt ?? undefined}>
              {formatUpdated(project?.updatedAt ?? null)}
            </time>
          </dd>
        </div>
        <div>
          <dt class="text-xs text-muted">Languages</dt>
          <dd class="mt-1 font-mono">{project?.languages.join(', ') || '–'}</dd>
        </div>
      </dl>

      {entry.data.stack.length > 0 && (
        <ul class="flex flex-wrap gap-2" aria-label="Stack">
          {entry.data.stack.map((s) => (
            <li class="rounded-full border border-border px-3 py-1 font-mono text-xs">{s}</li>
          ))}
        </ul>
      )}

      <div class="flex flex-wrap gap-3">
        <a href={repoUrl} class="btn-ghost" rel="noopener">
          View on GitHub
        </a>
        {demo && (
          <a href={demo} class="btn-primary" rel="noopener">
            Live demo
          </a>
        )}
      </div>
    </header>

    {entry.data.cover && (
      <Image
        src={entry.data.cover}
        alt={entry.data.coverAlt ?? ''}
        class="mt-10 w-full rounded-[var(--radius-card)] border border-border"
        widths={[640, 960, 1280]}
        sizes="(min-width: 896px) 896px, 100vw"
        loading="eager"
      />
    )}

    <div class="prose prose-ninja prose-lg mt-10 max-w-none">
      <Content />
    </div>

    <p class="mt-12 font-mono text-xs text-muted">Written {formatDate(entry.data.date)}</p>
  </article>

  <script>
    import { refreshRepoStats } from '../../lib/live-stats';
    refreshRepoStats();
  </script>
</BaseLayout>
