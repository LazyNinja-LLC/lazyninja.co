---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm';
import { SITE, SOCIALS } from '../config/site';
import { ogImagePath } from '../lib/seo';
---

<BaseLayout
  title="Contact"
  description="Get in touch with LazyNinja about a project, a role, or just to say hi."
  image={ogImagePath('contact')}
>
  <PageHeader
    eyebrow="Contact"
    title="Say hi"
    lead="Project idea, recruiting, or just a hello: it all lands in the same inbox."
  />
  <section class="container-page grid gap-12 py-12 lg:grid-cols-[1.6fr_1fr]">
    <div class="card relative p-6 sm:p-8">
      <ContactForm client:load apiUrl={SITE.apiUrl} email={SITE.person.email} />
      <noscript>
        <p class="mt-4 text-sm text-muted">
          The form needs JavaScript. Email{' '}
          <a class="link" href={`mailto:${SITE.person.email}`}>
            {SITE.person.email}
          </a>{' '}
          instead.
        </p>
      </noscript>
    </div>
    <aside class="space-y-6">
      <div class="card p-6">
        <h2 class="eyebrow mb-3">Direct</h2>
        <a class="link font-display text-lg font-semibold" href={`mailto:${SITE.person.email}`}>
          {SITE.person.email}
        </a>
      </div>
      <div class="card p-6">
        <h2 class="eyebrow mb-3">Elsewhere</h2>
        <ul class="space-y-2 text-sm">
          <li>
            <a class="link" href={SOCIALS.githubOrg.href} rel="noopener">
              {SOCIALS.githubOrg.label}
            </a>
          </li>
          <li>
            <a class="link" href={SOCIALS.githubPersonal.href} rel="noopener">
              {SOCIALS.githubPersonal.label}
            </a>
          </li>
          <li>
            <a class="link" href={SOCIALS.linkedin.href} rel="noopener">
              {SOCIALS.linkedin.label}
            </a>
          </li>
        </ul>
      </div>
      <p class="text-xs text-muted">
        Your message is stored so it can be answered and is never shared. No cookies, no tracking pixels.
      </p>
    </aside>
  </section>
</BaseLayout>
